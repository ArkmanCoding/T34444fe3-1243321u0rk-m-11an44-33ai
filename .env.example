# Turkmen AI - Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to git

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/turkmen-ai

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=turkmen_ai
DB_USER=root
DB_PASS=

# AI Provider (AvalAI)
AVALAI_API_KEY=your_key_here
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini